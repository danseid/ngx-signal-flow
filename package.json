{
  "name": "ngx-signal-flow-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve example",
    "build": "ng build ngx-signal-flow",
    "watch": "ng build ngx-signal-flow --watch --configuration development",
    "test": "ng test ngx-signal-flow --no-watch --no-progress",
    "test:example": "ng test example --no-watch --no-progress",
    "test:coverage": "ng test ngx-signal-flow --no-watch --no-progress --coverage --coverage-reporters text --coverage-reporters json-summary",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit",
    "build:lib": "ng build ngx-signal-flow --configuration=production",
    "postbuild:lib": "copyfiles README.md LICENSE dist/ngx-signal-flow",
    "release": "semantic-release",
    "performance": "npm run build:lib && node tools/performance.mjs",
    "performance:check": "node tools/performance.mjs --check"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/danseid/ngx-signal-flow.git"
  },
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "immer": "^11.1.17",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@vitest/coverage-v8": "^4.1.11",
    "copyfiles": "^2.4.1",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "npm": "file:tools/system-npm",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "~4.1.11"
  },
  "overrides": {
    "npm": "$npm"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "volta": {
    "node": "22.22.3"
  }
}
