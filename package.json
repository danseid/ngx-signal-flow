{
  "name": "ngx-signal-flow-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve example",
    "build": "ng build ngx-signal-flow",
    "watch": "ng build ngx-signal-flow --watch --configuration development",
    "test": "ng test ngx-signal-flow --no-watch --no-progress",
    "test:example": "ng test example --no-watch --no-progress",
    "build:lib": "ng build ngx-signal-flow --configuration=production",
    "postbuild:lib": "copyfiles README.md LICENSE dist/ngx-signal-flow",
    "release": "semantic-release",
    "bundle-report": "ng build example --configuration production --source-map && source-map-explorer dist/example/browser/*.js"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "immer": "^11.1.17",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "copyfiles": "^2.4.1",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "semantic-release": "^24.2.9",
    "typescript": "~6.0.3",
    "vitest": "~4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "volta": {
    "node": "22.22.3"
  }
}
